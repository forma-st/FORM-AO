<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>com.formast.formao.veille</string>
  <key>WorkingDirectory</key><string>__DOSSIER__</string>
  <key>ProgramArguments</key>
  <array>
    <string>__DOSSIER__/.venv/bin/python</string>
    <string>manage.py</string>
    <string>veille_quotidienne</string>
    <string>--si-prevu</string>
  </array>
  <!-- Vérifie toutes les 15 minutes : la veille tourne une fois par jour, à partir de l'heure
       choisie dans FORM'AO (Paramètres). Si le Mac dormait, elle est rattrapée au réveil. -->
  <key>StartInterval</key><integer>900</integer>
  <key>RunAtLoad</key><true/>
  <key>StandardOutPath</key><string>__JOURNAUX__/veille.log</string>
  <key>StandardErrorPath</key><string>__JOURNAUX__/veille.log</string>
</dict>
</plist>
