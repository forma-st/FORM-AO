# Copier ce fichier en .env et compléter.
DJANGO_SECRET_KEY=changer-moi-par-une-longue-chaine-aleatoire
DJANGO_DEBUG=0
DJANGO_ALLOWED_HOSTS=veille.mondomaine.fr
BASE_URL=https://veille.mondomaine.fr

# IA (console.anthropic.com > API Keys). Sans clé, le score se fait par règles.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
CLAUDE_EFFORT=medium

# Envoi des e-mails (digest et alertes)
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=smtp.mondomaine.fr
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=veille-ao@mondomaine.fr

# Prospection : option LinkedIn (à activer aussi dans Paramètres > Prospection).
# Application à créer sur https://www.linkedin.com/developers/apps avec les produits
# « Sign In with LinkedIn using OpenID Connect » et « Share on LinkedIn ».
# URL de redirection à déclarer : {BASE_URL}/prospection/linkedin/retour/
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# LINKEDIN_API_VERSION=202609
